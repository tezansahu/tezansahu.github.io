                "icon": "fab fa-github",
                "url": "https://github.com/tezansahu/building-eval-driven-ai-agents/tree/building-ai-agents-workshop"
            },
            {
                "label": "LinkedIn Post",
                "icon": "fab fa-linkedin",
                "url": "https://www.linkedin.com/posts/tezan-sahu_aiagents-microsoftagentframework-agenticai-ugcPost-7455436949839822848-m-lv"
            }
